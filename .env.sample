# Example environment for caddy-forward-auth.
# Copy to `.env` and replace users/hashes for your deployment.
# Never commit a real `.env` with production secrets.

HOST=0.0.0.0
PORT=8080
VERBOSE=false
# ALLOWED_ORIGINS CSV: exact hosts and/or hostGlobs (*.example.com, *). Empty = no Origin check.
ALLOWED_ORIGINS=intern-auth.example.com,localhost,*.intern.example.com

# SERVICE_<name>=hostGlob/username/passwordHash
# passwordHash must be valid bcrypt; bare host glob "*" matches any host.
SERVICE_test=test.example.com/tester/$2a$14$AnhQELX1cqeO3YaLPOTWtOuPsKZgweRHrYLcqzQUcvokbVZmzNWrO
SERVICE_intern=*.intern.example.com/intern-user/$2a$14$54tdWftb4iOouKyfDyURPuI6rOIwcbjqKYfzOqYE0PyOcmVFnU1mM

# IP whitelist (temporary pass after successful auth)
WHITELIST_ENABLED=true
WHITELIST_PERIOD_HOURS=48
WHITELIST_PATH=./data/ipwhitelist.json
# When true (default), an active whitelist entry bypasses bans
WHITELIST_OVERRIDES_BAN=true

# Flood tracking and IP bans
FLOOD_ENABLED=true
FLOOD_RETENTION_HOURS=168
FLOOD_CLEANUP_MINS=60
FLOOD_PATH=./data/flood.json
BAN_PATH=./data/ban.json
DATA_SAVE_SECS=30
# Clear flood failure history when a whitelisted probe hits
FLOOD_CLEAR_ON_WHITELIST=false
# Count probes with no credentials toward flood tiers
FLOOD_COUNT_NO_CREDENTIALS=true
# Count probes while temp-banned toward flood tiers
FLOOD_COUNT_TEMP_BAN_PROBES=true

# Flood tier 1: 10 failures in 2 minutes -> 3 minute temp ban
FLOOD_TIER1_COUNT=10
FLOOD_TIER1_WINDOW_MINS=2
FLOOD_TIER1_BAN_MINS=3
FLOOD_TIER1_PERMANENT=false
# Flood tier 2: 60 failures in 30 minutes -> 120 minute temp ban
FLOOD_TIER2_COUNT=60
FLOOD_TIER2_WINDOW_MINS=30
FLOOD_TIER2_BAN_MINS=120
FLOOD_TIER2_PERMANENT=false
# Flood tier 3: 90 failures in 60 minutes -> permanent ban
FLOOD_TIER3_COUNT=90
FLOOD_TIER3_WINDOW_MINS=60
FLOOD_TIER3_BAN_MINS=0
FLOOD_TIER3_PERMANENT=true
# Flood tier 4: 120 failures in 360 minutes -> permanent ban
FLOOD_TIER4_COUNT=120
FLOOD_TIER4_WINDOW_MINS=360
FLOOD_TIER4_BAN_MINS=0
FLOOD_TIER4_PERMANENT=true
# Flood tier 5: 240 failures in 10080 minutes (7 days) -> permanent ban
FLOOD_TIER5_COUNT=240
FLOOD_TIER5_WINDOW_MINS=10080
FLOOD_TIER5_BAN_MINS=0
FLOOD_TIER5_PERMANENT=true

# Logging (rejections are always logged; successes and whitelist hits are optional)
LOG_AUTH_SUCCESS=false
LOG_WHITELISTED=false

